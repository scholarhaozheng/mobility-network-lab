    "primal_residual": "||x-z||_2 in vehicles",
    "dual_residual": "rho*||z-z_previous||_2 in cost per vehicle",
    "stopping": "R1 absolute/relative primal and dual thresholds plus original-unit local conservation, capacity, projection, nonnegative, KKT and objective gates"
  },
  "scaling": {
    "row": "for commodity demand d>0, divide each incidence equality and its right-hand side by d: B*(x/d)=b/d; right-hand side source +1, sink -1",
