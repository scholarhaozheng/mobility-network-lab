    "equality": "x=z",
    "scaled_dual": "w[k,a]=unscaled_multiplier[k,a]/rho",
    "augmented_lagrangian": "sum_k c^T x[k]+rho/2*||x-z+w||_2^2-rho/2*||w||_2^2, with local conservation and consensus capacity indicators",
